<div class="index">
  <div class"create">
    <a href="/memos/new" class="button">新規作成</a>
  </div>

  <div class="list">
      <% @memos.each do |id, memo| %>
        <% next if memo["title"].to_s.strip.empty? && memo["content"].to_s.strip.empty? %>
        
        <div class="show-form memo">
          <a href="/memos/<%= id %>" class="title"><%= CGI.escapeHTML(memo["title"]) %></a>
          <%= CGI.escapeHTML(memo["content"]) %>
        </div>
      <% end %>
  </div>
</div>
